# Database
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_executive_platform?schema=public"
# Required by prisma/schema.prisma (datasource db { directUrl = env("DIRECT_URL") }).
# Prisma's env() throws "Environment variable not found" during `prisma generate`/
# `migrate` if this is unset at all — so it must always be present, even when you
# don't use a connection pooler. If you don't use a pooler (e.g. Neon/Supabase),
# just set it to the same value as DATABASE_URL, as below. If you do use a pooler,
# point DATABASE_URL at the pooled connection and DIRECT_URL at the non-pooled one.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_executive_platform?schema=public"

# JWT Authentication — CHANGE THIS IN PRODUCTION
JWT_SECRET="replace_with_a_strong_random_secret_minimum_32_chars"

# Server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# AI Provider — choose: openai | gemini | claude | groq
AI_PROVIDER=openai
ALLOW_CUSTOM_AI_BASE_URL=false
# Optional: override the model regardless of provider (falls back to each
# provider's *_MODEL variable, then a built-in default, if unset).
# AI_MODEL=

# OpenAI (or OpenAI-compatible endpoint)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
# AI_BASE_URL=  # Optional: custom OpenAI-compatible base URL

# Google Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-1.5-flash"

# Anthropic Claude
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY="your-claude-api-key"
# ANTHROPIC_MODEL="claude-3-5-haiku-20241022"

# Groq
# AI_PROVIDER=groq
# GROQ_API_KEY="your-groq-api-key"
# GROQ_MODEL="llama-3.3-70b-versatile"
APP_ENCRYPTION_KEY=replace_with_a_32_byte_hex_string_in_production 

# Google Drive import connector (service account)
# Share the target Drive folder with this service account email.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_TOKEN_URI="https://oauth2.googleapis.com/token"
# Optional alternative: store the whole service-account JSON as a single secret.
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=""

# Gmail import connector (OAuth 2.0)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/sources/gmail/callback"

# Microsoft Graph import connector (OAuth 2.0)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional. Defaults to "common" if omitted.
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:4000/api/sources/microsoft/callback"

# Frontend URL used after Gmail OAuth completes.
FRONTEND_URL="http://localhost:5173"
